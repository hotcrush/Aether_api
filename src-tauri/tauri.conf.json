{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Aether",
  "version": "0.1.0-alpha.13",
  "identifier": "com.siriu.aether",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Aether",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "dragDropEnabled": false,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFMkQ2Mzk3RTQ4RjhGRjAKUldUd2o0L2tsMk10TG5vd3ZtTHdHMHJTN3ZBTUNiVVNLVGNKNEJ5bkZ4cXhjZ1NFcWx1MFZnblIK",
      "endpoints": [
        "https://github.com/hotcrush/Aether_api/releases/latest/download/latest.json"
      ]
    }
  }
}
